# ─────────────────────────────────────────────────────────────
# Kingdom Foods Chatbot — environment variables
# Copy to .env and fill in. The service boots with NO keys (it
# falls through to a deterministic responder), so you can wire
# providers in one at a time.
# ─────────────────────────────────────────────────────────────

# Application
ENV=development                            # development | production
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://www.kingdom24.in,https://kingdom24.in,http://localhost:3000

# LLM providers — all free tier, all optional. Cascade order is
# customer_facing → Gemini → Groq 70B → Ollama → deterministic
# classification    → Groq 8B  → Gemini   → Ollama → keyword fallback
GEMINI_API_KEY=                            # https://aistudio.google.com/apikey
GROQ_API_KEY=                              # https://console.groq.com
OLLAMA_BASE_URL=http://localhost:11434     # leave blank to disable Ollama

# Twilio WhatsApp (optional — only needed for WhatsApp channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=                    # e.g. whatsapp:+14155238886
WEBHOOK_SECRET=                            # for Twilio signature validation

# Storage (optional — falls back to local JSON files in ./storage/)
SUPABASE_URL=
SUPABASE_KEY=

# Razorpay
RAZORPAY_PAYMENT_PAGE_ID=pl_SMfNZnTLY1GTcY
# Optional: enable real Razorpay Payment Link API (instead of just the page URL)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sales team — alerts when lead_score crosses threshold
SALES_TEAM_PHONE=918800804580
LEAD_ALERT_THRESHOLD=70

# Hard limits (don't change unless you know why)
GEMINI_DAILY_LIMIT=1500
GROQ_RPM_LIMIT=30
MAX_CONVERSATION_HISTORY=20
